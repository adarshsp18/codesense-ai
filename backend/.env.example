# Optional. Offline guided learning needs neither backend nor an API key.
AI_ENABLED=false
# Choose gemini or openai. Unset AI_PROVIDER keeps legacy OpenAI behavior.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Availability and free-tier quota depend on your Google AI Studio account.
GEMINI_MODEL=gemini-2.5-flash
# Optional alternative: set AI_PROVIDER=openai to use these settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Bind the server to 127.0.0.1. Browser CORS access is disabled by default.
